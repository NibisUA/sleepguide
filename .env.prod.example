# Copy to .env.prod on the server and fill in. Never commit .env.prod.
DOMAIN=sleepmaxxing.pp.ua

# Generate with: openssl rand -hex 16   (hex only, so it is safe inside the DB URL)
POSTGRES_PASSWORD=

# Token from @BotFather
BOT_TOKEN=

# Generate each with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=
WEBHOOK_SECRET=

# Public policy metadata (included in the frontend build; never put secrets here).
PRIVACY_OWNER=
PRIVACY_CONTACT=
# Set true only after the owner reviews the policy and completes all details.
PRIVACY_APPROVED=false
