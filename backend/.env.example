# dev | prod
ENV=dev
DATABASE_URL=postgresql+asyncpg://sleepguide:sleepguide@localhost:5432/sleepguide

# Telegram (create the bot with @BotFather)
BOT_TOKEN=
MINI_APP_URL=https://your-tunnel-or-vercel-url
# Public HTTPS base URL of the backend; the webhook is set on startup if BOT_TOKEN and this are set
WEBHOOK_BASE_URL=
WEBHOOK_SECRET=change-me-random-string

JWT_SECRET=change-me-long-random-string
JWT_TTL_MINUTES=60
INIT_DATA_MAX_AGE_SECONDS=86400

CORS_ORIGINS=["http://localhost:5173"]

# Login without Telegram, only for local development (ENV=dev)
DEV_LOGIN_ENABLED=true

# Background reminder loop (evening / morning bot messages). Needs BOT_TOKEN.
REMINDERS_ENABLED=true
