{
  "name": "sleepguide-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "gen:api": "openapi-typescript ../docs/openapi.json -o src/types/api.gen.ts",
    "gen:api:live": "openapi-typescript http://localhost:8000/openapi.json -o src/types/api.gen.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "predev": "node scripts/prepare-ocr.mjs",
    "prebuild": "node scripts/prepare-ocr.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.59.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/ukr": "^1.0.0",
    "i18next": "^24.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^15.0.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "axe-core": "^4.14.0",
    "jsdom": "^30.1.2",
    "openapi-typescript": "^7.4.0",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.6.0",
    "vite": "^6.0.0",
    "vitest": "^5.0.4"
  }
}
